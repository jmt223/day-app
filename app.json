{
  "expo": {
    "name": "DAY",
    "slug": "day-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dayapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dayapp.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "DAY 작성 시 사진을 첨부하려면 사진 보관함 접근 권한이 필요해요.",
        "NSLocationWhenInUseUsageDescription": "DAY에 장소를 태그하려면 위치 접근 권한이 필요해요."
      }
    },
    "android": {
      "package": "com.dayapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DAY 작성 시 사진을 첨부하려면 사진 보관함 접근 권한이 필요해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DAY에 장소를 태그하려면 위치 접근 권한이 필요해요."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "DAY 사진을 갤러리에 저장하려면 권한이 필요해요."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ea2cce2-4afe-4430-9309-ba723120be63"
      }
    },
    "owner": "jmt223",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5ea2cce2-4afe-4430-9309-ba723120be63"
    }
  }
}
