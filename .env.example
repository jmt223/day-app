# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹)에서 확인할 수 있는 값들.
# 이 파일을 .env로 복사한 뒤 값을 채워 넣으세요. (.env는 git에 커밋되지 않습니다)

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 구글 로그인. Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서
# "OAuth 2.0 클라이언트 ID" (유형: 웹 애플리케이션)를 만들면 나오는 클라이언트 ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 카카오 로그인. Kakao Developers > 내 애플리케이션 > 앱 키의 "REST API 키".
EXPO_PUBLIC_KAKAO_REST_API_KEY=
